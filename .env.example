# LifeOS runs without any environment variables in Local mode.
# Names below are reserved for the cloud-sync milestone and are NOT read by the
# current build. Never commit real values; copy to .env.local instead.

# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (public by design; RLS protects data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the browser, the extension or the companion.
# Not needed by any current code path.
SUPABASE_SERVICE_ROLE_KEY=

# Extension build only: comma-separated LifeOS origins allowed to message the
# extension. Defaults to http://localhost:3000.
LIFEOS_ORIGINS=
